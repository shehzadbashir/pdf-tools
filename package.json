{
  "name": "pdf-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build && wrangler pages dev dist",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:create": "wrangler d1 create pdf-tools",
    "db:migrate": "wrangler d1 execute pdf-tools --remote --file migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute pdf-tools --local --file migrations/0001_init.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "docx": "^9.7.2",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "pdf-lib": "^1.17.1",
    "pdf-lib-encrypt": "^1.0.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
